# ==============================================================================
# Database Configuration (Neon / PostgreSQL)
# ==============================================================================
# Connection string to your PostgreSQL instance (e.g., Neon serverless Postgres)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Object Storage (Cloudflare R2 / S3-Compatible)
# ==============================================================================
ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
ACCOUNT_ID="your_cloudflare_account_id"
ACCESS_KEY_ID="your_r2_access_key_id"
SECRET_ACCESS_KEY="your_r2_secret_access_key"
BUCKET_NAME="certificates"
TOKEN_ID="your_optional_token_id"

# ==============================================================================
# Background Processing (Inngest)
# ==============================================================================
# Set to 1 for local development mode
INNGEST_DEV="1"

# ==============================================================================
# Email Delivery (Resend)
# ==============================================================================
RESEND_API_KEY="re_your_resend_api_key"